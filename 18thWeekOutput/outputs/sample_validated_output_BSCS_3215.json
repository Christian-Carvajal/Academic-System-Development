{
  "course_metadata": {
    "course_code": "BSCS 3215",
    "course_title": "Parallel and Distributed Computing",
    "credit_units": 3,
    "lecture_hours": 2,
    "lab_hours": 3,
    "prerequisites": "BSCS 3109 (Operating System Configuration and Use)",
    "course_description": "Foundational principles and architectures of concurrent, parallel, and distributed computing systems. Topics encompass Flynn's taxonomy, shared-memory programming (OpenMP/pthreads), distributed-memory message passing (MPI), massively parallel GPU programming (CUDA), distributed consensus algorithms, cloud cluster parallelism, and performance scalability metrics."
  },
  "course_outcomes": [
    {
      "clo_id": "CLO1",
      "description": "Analyze complex computing problems and evaluate parallel algorithm scalability using Flynn's taxonomy.",
      "bloom_level": "Analyze",
      "program_outcomes_mapped": [
        "PLO1"
      ]
    },
    {
      "clo_id": "CLO2",
      "description": "Implement high-performance shared-memory programs utilizing OpenMP and pthreads for concurrent execution.",
      "bloom_level": "Apply",
      "program_outcomes_mapped": [
        "PLO2"
      ]
    },
    {
      "clo_id": "CLO3",
      "description": "Evaluate the efficiency of distributed consensus algorithms and cloud cluster parallelism under varying workloads.",
      "bloom_level": "Evaluate",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO5"
      ]
    },
    {
      "clo_id": "CLO4",
      "description": "Create optimized massively parallel GPU programming solutions using CUDA for large-scale data processing tasks.",
      "bloom_level": "Create",
      "program_outcomes_mapped": [
        "PLO2",
        "PLO5"
      ]
    }
  ],
