{
  "course_metadata": {
    "course_code": "BSCS 3214",
    "course_title": "Data Visualization",
    "credit_units": 3,
    "lecture_hours": 2,
    "lab_hours": 3,
    "prerequisites": "BSCS 3111 (Data Mining)",
    "course_description": "Theories and hands-on practices of visual data analytics and graphical storytelling, including visual perception cognition, the Grammar of Graphics, interactive dashboard construction, exploratory plotting with modern tools (Plotly, D3.js, Seaborn), multidimensional and geospatial visualization, and effective communication of data insights."
  },
  "course_outcomes": [
    {
      "clo_id": "CLO1",
      "description": "Design complex visual interfaces adhering to the Grammar of Graphics standards for optimal data representation.",
      "bloom_level": "Create",
      "program_outcomes_mapped": [
        "PLO2",
        "PLO5"
      ]
    },
    {
      "clo_id": "CLO2",
      "description": "Implement interactive dashboards using Plotly and D3.js libraries to process multidimensional datasets.",
      "bloom_level": "Apply",
      "program_outcomes_mapped": [
        "PLO2",
        "PLO5"
      ]
    },
    {
      "clo_id": "CLO3",
      "description": "Analyze visual perception cognition to enhance the clarity and interpretability of graphical data presentations.",
      "bloom_level": "Analyze",
      "program_outcomes_mapped": [
        "PLO3",
        "PLO5"
      ]
    },
    {
      "clo_id": "CLO4",
      "description": "Evaluate the efficacy of data storytelling techniques in conveying quantitative insights to diverse audiences.",
      "bloom_level": "Evaluate",
      "program_outcomes_mapped": [
        "PLO3"
      ]
    }
  ],
