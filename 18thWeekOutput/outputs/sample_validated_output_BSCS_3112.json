{
  "course_metadata": {
    "course_code": "BSCS 3112",
    "course_title": "Artificial Intelligence",
    "credit_units": 3,
    "lecture_hours": 2,
    "lab_hours": 3,
    "prerequisites": "CS 3110 (Data Structures and Algorithms)",
    "course_description": "Foundational and modern principles of artificial intelligence, including intelligent agents, state-space search heuristics (A*, Minimax), knowledge representation, first-order logic, probabilistic reasoning, machine learning pipelines, deep neural networks, computer vision, natural language processing, and ethical considerations in autonomous systems."
  },
  "course_outcomes": [
