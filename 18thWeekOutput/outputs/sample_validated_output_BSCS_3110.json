{
  "course_metadata": {
    "course_code": "BSCS 3110",
    "course_title": "Information Assurance and Security",
    "credit_units": 3,
    "lecture_hours": 2,
    "lab_hours": 3,
    "prerequisites": "CS 2207 (Data Communications and Networking)",
    "course_description": "Core principles of cybersecurity and information assurance, focusing on the CIA triad (Confidentiality, Integrity, Availability), symmetric and asymmetric cryptography, public key infrastructure (PKI), secure network architectures, threat modeling, vulnerability assessment, intrusion detection systems, and institutional security governance."
  },
  "course_outcomes": [
    {
      "clo_id": "CLO1",
      "description": "Analyze computing problems and apply cybersecurity fundamentals to identify risks within complex systems.",
      "bloom_level": "Analyze",
      "program_outcomes_mapped": [
        "PLO1"
      ]
    },
    {
      "clo_id": "CLO2",
      "description": "Implement symmetric and asymmetric cryptographic protocols within secure network architectures using PKI standards.",
      "bloom_level": "Apply",
      "program_outcomes_mapped": [
        "PLO5"
      ]
    },
    {
      "clo_id": "CLO3",
      "description": "Evaluate intrusion detection systems and vulnerability assessment tools against established threat models.",
      "bloom_level": "Evaluate",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO5"
      ]
    },
    {
      "clo_id": "CLO4",
      "description": "Create institutional security governance policies aligned with professional responsibilities and legal compliance.",
      "bloom_level": "Create",
      "program_outcomes_mapped": [
        "PLO4"
      ]
    }
