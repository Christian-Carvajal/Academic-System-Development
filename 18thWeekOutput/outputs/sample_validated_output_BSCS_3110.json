{
  "course_metadata": {
    "course_code": "BSCS 3110",
    "course_title": "Information Assurance and Security",
    "credit_units": 3,
    "lecture_hours": 2,
    "lab_hours": 3,
    "prerequisites": "CS 2207 (Data Communications and Networking)",
    "course_description": "Core principles of cybersecurity and information assurance, focusing on the CIA triad (Confidentiality, Integrity, Availability), symmetric and asymmetric cryptography, public key infrastructure (PKI), secure network architectures, threat modeling, vulnerability assessment, intrusion detection systems, and institutional security governance."
  },
  "course_outcomes": [
    {
      "clo_id": "CLO1",
      "description": "Analyze computing problems and apply fundamental cybersecurity principles to protect data confidentiality, integrity, and availability.",
      "bloom_level": "Apply",
      "program_outcomes_mapped": [
        "PLO1"
      ]
    },
    {
      "clo_id": "CLO2",
      "description": "Design secure network architectures utilizing symmetric and asymmetric cryptography within a Public Key Infrastructure (PKI).",
      "bloom_level": "Create",
      "program_outcomes_mapped": [
        "PLO5"
      ]
    },
    {
      "clo_id": "CLO3",
      "description": "Evaluate vulnerability assessment tools and intrusion detection systems to mitigate identified security threats.",
      "bloom_level": "Evaluate",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO4"
      ]
    },
    {
      "clo_id": "CLO4",
      "description": "Implement institutional security governance frameworks ensuring professional responsibility and informed judgment in computing practice.",
      "bloom_level": "Apply",
      "program_outcomes_mapped": [
        "PLO4",
        "PLO5"
      ]
    }
  ],
