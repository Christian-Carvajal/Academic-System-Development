{
  "course_metadata": {
    "course_code": "BSCS 3111",
    "course_title": "Data Mining",
    "credit_units": 3,
    "lecture_hours": 2,
    "lab_hours": 3,
    "prerequisites": "CS 3112 (Database Systems 1)",
    "course_description": "Principles, algorithms, and applications of knowledge discovery in databases (KDD), including data cleaning and preprocessing, exploratory data analysis, ETL pipelines, association rule mining (Apriori, FP-Growth), classification algorithms (Decision Trees, Naive Bayes, SVM), clustering techniques (K-Means, DBSCAN), and evaluation metrics."
  },
  "course_outcomes": [
    {
      "clo_id": "CLO1",
      "description": "Analyze raw datasets to identify patterns, anomalies, and data quality issues for preprocessing.",
      "bloom_level": "Analyze",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO2"
      ]
    },
    {
      "clo_id": "CLO2",
      "description": "Design and implement ETL pipelines to transform, clean, and integrate data for mining operations.",
      "bloom_level": "Create",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO3"
      ]
    },
    {
      "clo_id": "CLO3",
      "description": "Evaluate classification algorithms (Decision Trees, Naive Bayes, SVM) using accuracy, precision, and recall metrics.",
      "bloom_level": "Evaluate",
      "program_outcomes_mapped": [
        "PLO2",
        "PLO4"
      ]
    },
    {
      "clo_id": "CLO4",
      "description": "Formulate clustering solutions (K-Means, DBSCAN) to segment data and extract meaningful groupings.",
      "bloom_level": "Create",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO3"
      ]
    }
  ],
