{
  "course_metadata": {
    "course_code": "BSCS 3111",
    "course_title": "Data Mining",
    "credit_units": 3,
    "lecture_hours": 2,
    "lab_hours": 3,
    "prerequisites": "CS 3112 (Database Systems 1)",
    "course_description": "Principles, algorithms, and applications of knowledge discovery in databases (KDD), including data cleaning and preprocessing, exploratory data analysis, ETL pipelines, association rule mining (Apriori, FP-Growth), classification algorithms (Decision Trees, Naive Bayes, SVM), clustering techniques (K-Means, DBSCAN), and evaluation metrics."
  },
  "course_outcomes": [
    {
      "clo_id": "CLO1",
      "description": "Implement ETL pipelines and perform data cleaning to prepare datasets for analysis.",
      "bloom_level": "Apply",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO5"
      ]
    },
    {
      "clo_id": "CLO2",
      "description": "Analyze large datasets using association rule mining and classification algorithms to extract patterns.",
      "bloom_level": "Analyze",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO2"
      ]
    },
    {
      "clo_id": "CLO3",
      "description": "Evaluate clustering techniques and model performance using appropriate metrics for accuracy and precision.",
      "bloom_level": "Evaluate",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO2"
      ]
    },
    {
      "clo_id": "CLO4",
      "description": "Design a comprehensive knowledge discovery in databases (KDD) project integrating data mining techniques.",
      "bloom_level": "Create",
      "program_outcomes_mapped": [
        "PLO1",
