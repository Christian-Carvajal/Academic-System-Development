{
  "course_metadata": {
    "course_code": "BSCS 3111",
    "course_title": "Data Mining",
    "credit_units": 3,
    "lecture_hours": 2,
    "lab_hours": 3,
    "prerequisites": "CS 3112 (Database Systems 1)",
    "course_description": "Principles, algorithms, and applications of knowledge discovery in databases (KDD), including data cleaning and preprocessing, exploratory data analysis, ETL pipelines, association rule mining (Apriori, FP-Growth), classification algorithms (Decision Trees, Naive Bayes, SVM), clustering techniques (K-Means, DBSCAN), and evaluation metrics."
  },
  "course_outcomes": [
    {
      "clo_id": "CLO1",
      "description": "Analyze raw datasets to perform data cleaning, preprocessing, and exploratory analysis using ETL pipelines.",
      "bloom_level": "Apply",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO5"
      ]
    },
    {
      "clo_id": "CLO2",
      "description": "Implement classification algorithms such as Decision Trees, Naive Bayes, and SVM to predict categorical outcomes.",
      "bloom_level": "Create",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO2"
      ]
    },
    {
      "clo_id": "CLO3",
      "description": "Design clustering techniques including K-Means and DBSCAN to identify patterns within unlabeled data.",
      "bloom_level": "Analyze",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO2"
      ]
    },
    {
      "clo_id": "CLO4",
      "description": "Evaluate mining models using accuracy, precision, recall, and F-measure metrics to ensure analytical validity.",
      "bloom_level": "Evaluate",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO2",
        "PLO5"
      ]
    }
  ],
