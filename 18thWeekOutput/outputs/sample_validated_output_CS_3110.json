{
  "course_metadata": {
    "course_code": "CS 3110",
    "course_title": "Data Structures and Algorithms",
    "credit_units": 3,
    "lecture_hours": 2,
    "lab_hours": 3,
    "prerequisites": "CS 2110 (Computer Programming 2)",
    "course_description": "Comprehensive study of abstract data types, recursive algorithms, dynamic memory allocation, trees, sorting algorithms, and Big-O computational complexity."
  },
  "course_outcomes": [
    {
      "clo_id": "CLO1",
      "description": "Analyze the fundamental properties of abstract data types and their implementation using dynamic memory allocation.",
      "bloom_level": "Analyze",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO2"
      ]
    },
    {
      "clo_id": "CLO2",
      "description": "Design recursive algorithms to solve complex computational problems efficiently.",
      "bloom_level": "Create",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO3"
      ]
    },
    {
      "clo_id": "CLO3",
      "description": "Evaluate the time and space complexity of sorting algorithms using Big-O notation.",
      "bloom_level": "Evaluate",
      "program_outcomes_mapped": [
        "PLO2",
        "PLO4"
      ]
    },
    {
      "clo_id": "CLO4",
      "description": "Implement tree data structures to organize and retrieve hierarchical information systematically.",
      "bloom_level": "Apply",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO3"
      ]
    }
  ],
