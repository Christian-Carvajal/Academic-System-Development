{
  "course_metadata": {
    "course_code": "BSCS 3213",
    "course_title": "Software Engineering",
    "credit_units": 3,
    "lecture_hours": 2,
    "lab_hours": 3,
    "prerequisites": "CS 3110 (Data Structures and Algorithms)",
    "course_description": "Systematic engineering methodologies for software development, covering SDLC models, Agile/Scrum frameworks, requirements engineering, object-oriented analysis and design with UML, architectural patterns, unit and integration testing, continuous integration and deployment (CI/CD), and software project management."
  },
  "course_outcomes": [
    {
      "clo_id": "CLO1",
      "description": "Design software development plans using SDLC models and Agile frameworks while formulating comprehensive requirements specifications.",
      "bloom_level": "Apply",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO2"
      ]
    },
    {
      "clo_id": "CLO2",
      "description": "Analyze system complexities to create accurate Object-Oriented Analysis and Design diagrams using UML notation.",
      "bloom_level": "Analyze",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO3"
      ]
    },
    {
      "clo_id": "CLO3",
      "description": "Evaluate software quality by implementing unit testing strategies and configuring continuous integration/deployment pipelines.",
      "bloom_level": "Evaluate",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO4"
      ]
    },
    {
      "clo_id": "CLO4",
      "description": "Create a functional software project by managing resources, timelines, and delivering solutions through systematic engineering methodologies.",
      "bloom_level": "Create",
      "program_outcomes_mapped": [
        "PLO1",
        "PLO2"
      ]
    }
  ],
